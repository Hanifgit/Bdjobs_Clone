@model RegistrationPage.Models.CategoryViewModel

<h2>Add Category</h2>

<form asp-action="Category" method="post">
    <div class="form-group">
        <label asp-for="CategoryName">Category Name</label>
        <input asp-for="CategoryName" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>


