@model List<RegistrationPage.Models.ApplicationViewModel>

@{
    ViewData["Title"] = "Applicants";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h3>Applicants for the Job</h3>
    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Applicant Name</th>
                <th>Application Date</th>
                <th>Job Title</th>
                <th>Actions</th>
                
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var applicant in Model)
                {
                    <tr>
                        <td>@applicant.Name</td>
                        <td>@applicant.ApplicationDate.ToString("yyyy-MM-dd")</td>
                        <td>@applicant.JobTitle</td>
                        <td>
                            <a href="@Url.Action("MyJobDetails", "CreateAccountDashboard", new { id = applicant.CreateAccountId })" class="btn btn-info btn-sm">
                                Applicant Profile
                            </a> |

                            <a href="@Url.Action("ViewCV" , "CV", new {createAccountId = applicant.CreateAccountId })" class="btn btn-info btn-sm">
                                Applicant CV
                            </a> 
            

                        </td> 
                       
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center">No applicants found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>


