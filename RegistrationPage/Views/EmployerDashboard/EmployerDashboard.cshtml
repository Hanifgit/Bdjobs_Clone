@model RegistrationPage.Models.EmployerDashboardViewModel

@{
    ViewData["Title"] = "Employer Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Company Dashboard</h3>
        </div>
        <div class="card-body">
            <table class="table table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Company Name</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="align-middle"><strong>@Model.CompanyName</strong></td>
                        <td class="align-middle">
                            <a asp-action="EmployerDetails" asp-route-id="@Model.Id" class="btn btn-info btn-sm">
                                <i class="fas fa-info-circle"></i> Details
                            </a>
                            <a asp-action="EmployerEdit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <a asp-action="EmployerDelete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>

                            <a href="@Url.Action("MyJobPost", "EmployerDashboard")" class="btn btn-info">My All Job Posts</a>
                            <a href="@Url.Action("ViewApplicant", "EmployerDashboard")" class="btn btn-primary">Applicant View</a>

                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

   @*  <div class="mt-3 text-center">
        <a asp-action="EmployerLogout" asp-controller="EmployerLogin" class="btn btn-outline-danger">
            <i class="fas fa-sign-out-alt"></i> Logout
        </a>
    </div> *@
</div>



