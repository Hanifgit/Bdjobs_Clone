@model List<JobPostViewModel>

<h2>My Job Posts</h2>

<table class="table">
    <thead>
        <tr>
            <th>Job Title</th>
            <th>Category</th>
            <th>Location</th>
            <th>Posted Date</th>
            <th>Deadline</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if(Model.Any())
        {
            @foreach (var job in Model)
            {
                <tr>
                    <td>@job.JobTitle</td>
                    <td>@job.CategoryName</td>
                    <td>@job.JobLocation</td>
                    <td>@job.JobPostedDate.ToString("dd MMMM yyyy")</td>
                    <td>@job.ApplicationDeadline.ToString("dd MMMM yyyy")</td>
                    <td>
                        <a href="@Url.Action("JobEdit", "JobPost", new { id = job.Id })" class="btn btn-warning">Edit</a> |
                        <a href="@Url.Action("JobDelete", "JobPost", new { id = job.Id })" class="btn btn-danger">Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center">This Company No Job Post</td>
            </tr>
        }
    </tbody>
</table>
