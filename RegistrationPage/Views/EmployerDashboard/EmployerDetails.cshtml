@model RegistrationPage.Models.Entities.Employer

@{
    ViewData["Title"] = "EmployerDetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="text-primary">Employer Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Username)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Username)
       
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CompanyName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CompanyName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.YearOfEstablishment)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.YearOfEstablishment)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CompanySize)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CompanySize)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IndustryType)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IndustryType)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ContactPersonName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ContactPersonName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ContactPersonDesignation)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ContactPersonDesignation)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ContactPersonEmail)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ContactPersonEmail)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ContactPersonPhone)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ContactPersonPhone)
        </dd>
       
    </dl>

    <h3 class="text-info">Company Address</h3>
    @if (Model.EmployerAddresses != null && Model.EmployerAddresses.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Country</th>
                    <th>District</th>
                    <th>Upazila</th>
                    <th>Address</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var address in Model.EmployerAddresses)
                {
                    <tr>
                        <td>@address.Country.Name</td>
                        <td>@address.District.Name</td>
                        <td>@address.Upazila.Name</td>
                        <td>@address.CompanyAddress</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No address available.</p>
    }

</div>



<div>
   @*  <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> | *@
    <a asp-action="EmployerDashboard"  class="btn btn-primary">Back to Dashboard</a>
</div>
