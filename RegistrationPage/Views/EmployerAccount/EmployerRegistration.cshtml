@model RegistrationPage.Models.EmployerRegistrationViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Employer Create Account</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f9f9f9;
            font-family: Arial, sans-serif;
        }

        .registration-form {
            max-width: 800px;
            margin: 20px auto;
            background: #fff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

            .registration-form h2 {
                text-align: center;
                margin-bottom: 20px;
                color: #007bff;
            }

        .form-control {
            border-radius: 5px;
        }

        .form-group label {
            font-weight: bold;
            margin-top: 10px;
        }

        .form-section {
            margin-bottom: 20px;
        }

        .btn-primary {
            width: 100%;
            padding: 10px;
            font-size: 16px;
        }
    </style>
</head>

<body>
    <div class="registration-form">
        <h2>Employer Create Account</h2>
        <form asp-action="EmployerRegistration" method="post">
            <div class="form-section">
                <h3>Personal Information</h3>
                <div class="form-group">
                    <label>Username</label>
                    <input asp-for="Username" class="form-control" placeholder="Enter user name" />
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" />
                </div>
                <div class="form-group">
                    <label>Company Name</label>
                    <input asp-for="CompanyName" class="form-control" placeholder="Enter your company name" />
                </div>
                <div class="form-group">
                    <label>Year Of Establishment</label>
                    <select asp-for="YearOfEstablishment" asp-items="Model.YearDropdown" class="form-control">
                        <option value="">-- Select Year --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Company Size</label>
                    <input asp-for="CompanySize" class="form-control" placeholder="your company size" />
                </div>
                <div class="form-group">
                    <label>Industry Type</label>
                    <input asp-for="IndustryType" class="form-control" placeholder="Enter your industry type" />
                </div>
                <div class="form-group">
                    <label>Contact Person Name</label>
                    <input asp-for="ContactPersonName" class="form-control" placeholder="Enter contact person name" />
                </div>
                <div class="form-group">
                    <label>Contact Person Designation</label>
                    <input asp-for="ContactPersonDesignation" class="form-control" placeholder="Enter designation" />
                </div>
                <div class="form-group">
                    <label>Contact Person Email</label>
                    <input asp-for="ContactPersonEmail" class="form-control" placeholder="Enter Email" />
                </div>
                <div class="form-group">
                    <label>Contact Person Phone</label>
                    <input asp-for="ContactPersonPhone" class="form-control" placeholder="Enter phone number" />
                </div>
               
            </div>

            <div class="form-section">
                <h3>Address Information</h3>
                @* <div class="form-group">
                <label>Country</label>
                <select id="CountryId" name="SelectedCountry" asp-items="Model.Countries" class="form-control">
                <option value="">-- Select Country --</option>
                </select>
                </div>
                <div class="form-group">
                <label>District</label>
                <select id="DistrictId" name="SelectedDistrict" asp-items="Model.Districts" class="form-control">
                <option value="">-- Select District --</option>
                </select>
                </div>
                <div class="form-group">
                <label>Upazila</label>
                <select id="UpazilaId" name="SelectedUpazila" asp-items="Model.Upazilas" class="form-control">
                <option value="">-- Select Upazila --</option>
                </select>
                </div>  *@

                <div class="form-group">
                    <label for="SelectedCountry">Country</label>
                    <select id="SelectedCountry" name="SelectedCountry" class="form-control">
                        <option value="">-- Select Country --</option>
                        @foreach (var country in Model.Countries)



                        {
                            <option value="@country.Value">@country.Text</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="SelectedDistrict">District</label>
                    <select id="SelectedDistrict" name="SelectedDistrict" class="form-control">
                        <option value="">-- Select District --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="SelectedUpazila">Upazila</label>
                    <select id="SelectedUpazila" name="SelectedUpazila" class="form-control">
                        <option value="">-- Select Upazila --</option>
                    </select>
                </div>


                <div class="form-group">
                    <label>Company Address</label>
                    <input asp-for="CompanyAddress" class="form-control" placeholder="Enter Company Address" />
                </div>
               
            </div>

           @*  <div class="form-section">
                <h3>Address Information</h3>
                <div class="form-group">
                    <label>Country</label>
                    <select id="CountryId" name="SelectedCountry" asp-items="Model.Countries" class="form-control">
                        <option value="">-- Select Country --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>District</label>
                    <select id="DistrictId" name="SelectedDistrict" asp-items="Model.Districts" class="form-control">
                        <option value="">-- Select District --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Upazila</label>
                    <select id="UpazilaId" name="SelectedUpazila" asp-items="Model.Upazilas" class="form-control">
                        <option value="">-- Select Upazila --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Company Address</label>
                    <input asp-for="CompanyAddress" class="form-control" placeholder="Enter address" />
                </div>
               
            </div> *@

            <button type="submit" class="btn btn-primary">Register</button>
        </form>
    </div>
</body>
</html>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $("#SelectedCountry").change(function () {
            var countryId = $(this).val();
            $("#SelectedDistrict").empty().append('<option value="">-- Select District --</option>');
            $("#SelectedUpazila").empty().append('<option value="">-- Select Upazila --</option>');

            if (countryId) {
                $.getJSON("/EmployerAccount/GetDistrictsByCountry", { countryId: countryId }, function (data) {
                    $.each(data, function (index, item) {
                        $("#SelectedDistrict").append($('<option>', {
                            value: item.id,
                            text: item.name
                        }));
                    });
                });
            }
        });

        $("#SelectedDistrict").change(function () {
            var districtId = $(this).val();
            $("#SelectedUpazila").empty().append('<option value="">-- Select Upazila --</option>');

            if (districtId) {
                $.getJSON("/EmployerAccount/GetUpazilasByDistrict", { districtId: districtId }, function (data) {
                    $.each(data, function (index, item) {
                        $("#SelectedUpazila").append($('<option>', {
                            value: item.id,
                            text: item.name
                        }));
                    });
                });
            }
        });
    });
</script>