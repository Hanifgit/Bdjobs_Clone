@model RegistrationPage.Models.Entities.CreateAccount

@{
    ViewData["Title"] = "MyJobDetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="text-center" >User Details</h1>

<div>
   
    <hr />
    <h3 class="text-info">Personal Information</h3>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MobileNumber)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MobileNumber)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Gender)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Gender)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Age)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Age)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Skill)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Skill)
        </dd>
       
    </dl>

    <h3 class="text-info">Address</h3>
    @if (Model.Addresses != null && Model.Addresses.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Country</th>
                    <th>District</th>
                    <th>Upazila</th>
                    <th>PostOffice</th>
                    <th>Village</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var address in Model.Addresses)
                {
                    <tr>
                        <td>@address.Country.Name</td>
                        <td>@address.District.Name</td>
                        <td>@address.Upazila.Name</td>
                        <td>@address.PostOffice</td>
                        <td>@address.Village</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No address available.</p>
    }

    <h3 class="text-info">Educational Qualification</h3>
    @if(Model.EducationalQualifications != null && Model.EducationalQualifications.Any())
    {
        <table class="table" >
            <thead>
                <tr>
                    <th>EducationalStage</th>
                    <th>NameOfEducationalInstitution</th>
                    <th>MajorSubject</th>
                    <th>Board</th>
                    <th>YearOfPassing</th>
                </tr>
            </thead>

            <tbody>
                @foreach(var eq in Model.EducationalQualifications)
                {
                    <tr>
                        <td>@eq.EducationalStage</td>
                        <td>@eq.NameOfEducationalInstitution</td>
                        <td>@eq.MajorSubject</td>
                        <td>@eq.Board</td>
                        <td>@eq.YearOfPassing</td>
                    </tr>
                }
            </tbody>
        </table>
    }

</div>
<div>

    <div>
        @if (ViewBag.IsEmployer == true)
        {
            <!-- If Employer is logged in, show this button -->
            <a href="@Url.Action("ViewApplicant", "EmployerDashboard", new { jobId = ViewBag.JobId })" class="btn btn-success">
                Back to Applicants List
            </a>
        }
        else
        {
            <!-- If CreateAccount user is logged in, show this button -->
            <a href="@Url.Action("MyJobDashboard", "CreateAccountDashboard")" class="btn btn-success">
                Back to Dashboard
            </a>
        }
    </div>


</div>
