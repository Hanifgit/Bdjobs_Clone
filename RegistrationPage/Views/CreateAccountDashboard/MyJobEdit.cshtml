  @model RegistrationPage.Models.CreateAccountDashboardViewModel

@{
    ViewData["Title"] = "My Job Edit ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-primary">My Job Edit</h2>
@* <hr /> *@

<div class="row">
    <div class="col-md-6">
        <form asp-action="MyJobEdit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-1">
                <label class="form-label fw-bold">Name :</label>
              @*   <label asp-for="Name" class="control-label"></label> *@
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-1">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-label fw-bold">
                <label asp-for="MobileNumber" class="control-label"></label>
                <input asp-for="MobileNumber" class="form-control" />
                <span asp-validation-for="MobileNumber" class="text-danger"></span>
            </div>

            <div class="mb-1">
                <label class="form-label fw-bold">Gender</label><br/>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="Gender" id="male" value="Male"
                    @(Model.Gender == "Male" ? "checked" : "")>
                    <label class="form-check-label" for="male">Male</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="Gender" id="female" value="Female"
                    @(Model.Gender == "Female" ? "checked" : "")>
                    <label class="form-check-label" for="female">Female</label>
                </div>
            </div>


            <div class="form-group">
                <label asp-for="Age" class="control-label"></label>
                <input asp-for="Age" class="form-control" />
                <span asp-validation-for="Age" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Skill" class="control-label"></label>
                <input asp-for="Skill" class="form-control" />
                <span asp-validation-for="Skill" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="control-label"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>


            <h5 class="mt-4">Address</h5>
            @if (Model.Addresses != null && Model.Addresses.Any())
            {
                for (int i = 0; i < Model.Addresses.Count; i++)
                {
                    var address = Model.Addresses[i];

                <input type="hidden" name="Addresses[@i].Id" value="@address.Id" />

                <div class="form-group">
                    <label>Country</label>
                    <select name="Addresses[@i].CountryId" class="form-control country-dropdown" 
                            data-address-index="@i"
                            asp-items="ViewBag.Countries">
                        <option value="">-- Select Country --</option>
                    </select>
                    <span class="text-danger">@Html.ValidationMessage("Addresses[@i].CountryId")</span>
                </div>

                <div class="form-group">
                    <label>District</label>
                    <select name="Addresses[@i].DistrictId" class="form-control district-dropdown" 
                            data-address-index="@i"
                            asp-items="ViewBag.Districts">
                        <option value="">-- Select District --</option>
                    </select>
                    <span class="text-danger">@Html.ValidationMessage("Addresses[@i].DistrictId")</span>
                </div>

                <div class="form-group">
                    <label>Upazila</label>
                    <select name="Addresses[@i].UpazilaId" class="form-control upazila-dropdown" 
                            data-address-index="@i"
                            asp-items="ViewBag.Upazilas">
                        <option value="">-- Select Upazila --</option>
                    </select>
                    <span class="text-danger">@Html.ValidationMessage("Addresses[@i].UpazilaId")</span>
                </div>

                         <div class="form-group">
                            <label>Post Office</label>
                            <input type="text" name="Addresses[0].PostOffice" value="@address.PostOffice" class="form-control" />
                            <span class="text-danger">@Html.ValidationMessage("Addresses[0].PostOffice")</span>
                        </div>

                        <div class="form-group">
                            <label>Village</label>
                            <input type="text" name="Addresses[0].Village" value="@address.Village" class="form-control" />
                            <span class="text-danger">@Html.ValidationMessage("Addresses[0].Village")</span>
                        </div>

                }
            }


            @*  @if (Model.Addresses != null && Model.Addresses.Any())
            {
                var address = Model.Addresses.First(); // Assuming one address per employer

                <input type="hidden" name="Addresses[0].Id" value="@address.Id" />

                <div class="form-group">
                    <label>Country</label>
                    <select name="Addresses[0].CountryId" class="form-control" asp-items="ViewBag.Countries">
                        <option value="">-- Select Country --</option>
                    </select>
                    <span class="text-danger">@Html.ValidationMessage("Addresses[0].CountryId")</span>
                </div>

                <div class="form-group">
                    <label>District</label>
                    <select name="Addresses[0].DistrictId" class="form-control" asp-items="ViewBag.Districts">
                        <option value="">-- Select District --</option>
                    </select>
                    <span class="text-danger">@Html.ValidationMessage("Addresses[0].DistrictId")</span>
                </div>

                <div class="form-group">
                    <label>Upazila</label>
                    <select name="Addresses[0].UpazilaId" class="form-control" asp-items="ViewBag.Upazilas">
                        <option value="">-- Select Upazila --</option>
                    </select>
                    <span class="text-danger">@Html.ValidationMessage("Addresses[0].UpazilaId")</span>
                </div>

                <div class="form-group">
                    <label>Post Office</label>
                    <input type="text" name="Addresses[0].PostOffice" value="@address.PostOffice" class="form-control" />
                    <span class="text-danger">@Html.ValidationMessage("Addresses[0].PostOffice")</span>
                </div>

                <div class="form-group">
                    <label>Village</label>
                    <input type="text" name="Addresses[0].Village" value="@address.Village" class="form-control" />
                    <span class="text-danger">@Html.ValidationMessage("Addresses[0].Village")</span>
                </div>
            } 
            else
            {
                <p class="text-warning">No Address Found.</p>
            }  *@

            <h5 class="mt-4">Educational Qualifications</h5>
            @if(Model.EducationalQualifications != null && Model.EducationalQualifications.Any())
            {
                var educationalQualification = Model.EducationalQualifications.First();

                <input type="hidden" name="EducationalQualifications[0].Id" value="@educationalQualification.Id" />

                <div class="form-group">
                    <label>Educational Stage</label>
                    <input type="text" name="EducationalQualifications[0].EducationalStage" value="@educationalQualification.EducationalStage" class="form-control" />
                    <span class="text-danger">@Html.ValidationMessage("EducationalQualifications[0].EducationalStage")</span>
                </div>

                <div class="form-group">
                    <label>Name Of Educational Institution</label>
                    <input type="text" name="EducationalQualifications[0].NameOfEducationalInstitution" value="@educationalQualification.NameOfEducationalInstitution" class="form-control" />
                    <span class="text-danger">@Html.ValidationMessage("EducationalQualifications[0].NameOfEducationalInstitution")</span>
                </div>

                <div class="form-group">
                    <label>Major Subject</label>
                    <input type="text" name="EducationalQualifications[0].MajorSubject" value="@educationalQualification.MajorSubject" class="form-control" />
                    <span class="text-danger">@Html.ValidationMessage("EducationalQualifications[0].MajorSubject")</span>
                </div>

                <div class="form-group">
                    <label>Board</label>
                    <input type="text" name="EducationalQualifications[0].Board" value="@educationalQualification.Board" class="form-control" />
                    <span class="text-danger">@Html.ValidationMessage("EducationalQualifications[0].Board")</span>
                </div>

                <div class="form-group">
                    <label>Year Of Passing</label>
                    <select name="EducationalQualifications[0].YearOfPassing" class="form-control"
                            asp-items="ViewBag.YearOfPassing">
                        <option value="">-- Select Year --</option>
                    </select>
                    <span class="text-danger">@Html.ValidationMessage("EducationalQualifications[0].YearOfPassing")</span>
                </div>



            }

            else
            {
                <p class="text-warning">No Educational Qualification Found.</p>
            }

            <div class="form-group mt-3">
                <input type="submit" value="Save Changes" class="btn btn-primary" />
                <a asp-action="MyJobDashboard" class="btn btn-warning">Cancel</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
        <script>
            $(document).ready(function () {

                function loadDistricts(countryId, districtDropdown, selectedDistrictId) {
                    if (countryId) {
                        $.getJSON('/CreateAccountDashboard/GetDistrictsByCountry', { countryId: countryId }, function (data) {
                            districtDropdown.empty().append('<option value="">-- Select District --</option>');
                            $.each(data, function (i, district) {
                                districtDropdown.append('<option value="' + district.id + '">' + district.name + '</option>');
                            });
                            if (selectedDistrictId) {
                                districtDropdown.val(selectedDistrictId);
                            }
                        });
                    }
                }

                function loadUpazilas(districtId, upazilaDropdown, selectedUpazilaId) {
                    if (districtId) {
                        $.getJSON('/CreateAccountDashboard/GetUpazilasByDistrict', { districtId: districtId }, function (data) {
                            upazilaDropdown.empty().append('<option value="">-- Select Upazila --</option>');
                            $.each(data, function (i, upazila) {
                                upazilaDropdown.append('<option value="' + upazila.id + '">' + upazila.name + '</option>');
                            });
                            if (selectedUpazilaId) {
                                upazilaDropdown.val(selectedUpazilaId);
                            }
                        });
                    }
                }

                // Handle country change
                $('.country-dropdown').change(function () {
                    var countryId = $(this).val();
                    var index = $(this).data("address-index");
                    var districtDropdown = $('.district-dropdown[data-address-index="' + index + '"]');
                    var upazilaDropdown = $('.upazila-dropdown[data-address-index="' + index + '"]');

                    districtDropdown.empty().append('<option value="">-- Select District --</option>');
                    upazilaDropdown.empty().append('<option value="">-- Select Upazila --</option>');

                    if (countryId) {
                        loadDistricts(countryId, districtDropdown);
                    }
                });

                // Handle district change
                $('.district-dropdown').change(function () {
                    var districtId = $(this).val();
                    var index = $(this).data("address-index");
                    var upazilaDropdown = $('.upazila-dropdown[data-address-index="' + index + '"]');

                    upazilaDropdown.empty().append('<option value="">-- Select Upazila --</option>');

                    if (districtId) {
                        loadUpazilas(districtId, upazilaDropdown);
                    }
                });

                // Preload districts and upazilas when the page loads
                $('.country-dropdown').each(function () {
                    var index = $(this).data("address-index");
                    var countryId = $(this).val();
                    var districtDropdown = $('.district-dropdown[data-address-index="' + index + '"]');
                    var upazilaDropdown = $('.upazila-dropdown[data-address-index="' + index + '"]');
                    var selectedDistrictId = districtDropdown.val();
                    var selectedUpazilaId = upazilaDropdown.val();

                    if (countryId && selectedDistrictId) {
                        loadDistricts(countryId, districtDropdown, selectedDistrictId);
                    }

                    if (selectedDistrictId && selectedUpazilaId) {
                        loadUpazilas(selectedDistrictId, upazilaDropdown, selectedUpazilaId);
                    }
                });

            });
        </script>
}
