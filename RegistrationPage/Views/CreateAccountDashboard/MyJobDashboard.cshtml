@model RegistrationPage.Models.Entities.CreateAccount

@{
    ViewData["Title"] = "My Job Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">User Dashboard</h3>
        </div>
        <div class="card-body">
            <table class="table table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>User Name</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="align-middle"><strong>@Model.Name</strong></td>
                        <td class="align-middle">
                            <a asp-action="MyJobDetails" asp-route-id="@Model.Id" class="btn btn-info btn-sm">
                                <i class="fas fa-info-circle"></i> View Profile
                            </a>
                            <a asp-action="MyJobEdit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <a asp-action="MyJobDelete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>

                            <a asp-controller="CV" asp-action="ViewCV" asp-route-createAccountId="@Model.Id" class="btn btn-primary">View CV</a>
                            
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>



