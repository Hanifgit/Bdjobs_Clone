@model RegistrationPage.Models.Entities.JobPost

@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Job Details";
    var createAccountId = HttpContextAccessor.HttpContext.Session.GetInt32("CreateAccountId");
}


<div>
    <h4 class="text-primary">Company Name: @Model.Employer.CompanyName</h4>
    <h4>@Model.JobTitle</h4>
    <h5 class="text-danger">
        Application Deadline: @Model.ApplicationDeadline.ToString("dd MMMM yyyy")
    </h5>

    <hr />
    <dl class="row">
        <dt class="col-sm-3">Vacancy</dt>
        <dd class="col-sm-9">@Model.Vacancy</dd>

        <dt class="col-sm-3">Education Requirement</dt>
        <dd class="col-sm-9">@Model.EducationRequirement</dd>

        <dt class="col-sm-3">Experience</dt>
        <dd class="col-sm-9">@Model.ExperienceRequirement</dd>

        <dt class="col-sm-3">Additional Requirement</dt>
        <dd class="col-sm-9">@Model.AdditionalRequirement</dd>

        <dt class="col-sm-3">Responsibilities</dt>
        <dd class="col-sm-9">@Model.Responsibilitie</dd>

        <dt class="col-sm-3">Other Benefits</dt>
        <dd class="col-sm-9">@Model.OtherBenefit</dd>

        <dt class="col-sm-3">Workplace</dt>
        <dd class="col-sm-9">@Model.Workplace</dd>

        <dt class="col-sm-3">Employment Status</dt>
        <dd class="col-sm-9">@Model.EmploymentStatus</dd>

        <dt class="col-sm-3">Job Location</dt>
        <dd class="col-sm-9">@Model.JobLocation</dd>

        <dt class="col-sm-3">Salary</dt>
        <dd class="col-sm-9">@Model.Salary</dd>

        <dt class="col-sm-3">Job Posted Date</dt>
        <dd class="col-sm-9">@Model.JobPostedDate.ToString("dd MMMM yyyy")</dd>
    </dl>

    @if (createAccountId != null)
    {
        <form asp-controller="Application" asp-action="Apply" method="post">
            <input type="hidden" name="jobPostId" value="@Model.Id" />
            <button type="submit" class="btn btn-primary">Apply Now</button>
        </form>

    }
    else
    {
        <p class="text-danger">Please <a asp-controller="Account" asp-action="Login">log in</a> to apply.</p>
    }
    <a asp-action="BrowseCategory" class="btn btn-warning">Cancel</a>
</div>


