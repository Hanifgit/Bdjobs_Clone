@model RegistrationPage.Models.Entities.JobPost

@{
    ViewData["Title"] = "JobEdit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>JobEdit</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="JobEdit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="JobTitle" class="control-label"></label>
                <input asp-for="JobTitle" class="form-control" />
                <span asp-validation-for="JobTitle" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Vacancy" class="control-label"></label>
                <input asp-for="Vacancy" class="form-control" />
                <span asp-validation-for="Vacancy" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EducationRequirement" class="control-label"></label>
                <input asp-for="EducationRequirement" class="form-control" />
                <span asp-validation-for="EducationRequirement" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ExperienceRequirement" class="control-label"></label>
                <input asp-for="ExperienceRequirement" class="form-control" />
                <span asp-validation-for="ExperienceRequirement" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AdditionalRequirement" class="control-label"></label>
                <input asp-for="AdditionalRequirement" class="form-control" />
                <span asp-validation-for="AdditionalRequirement" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Responsibilitie" class="control-label"></label>
                <input asp-for="Responsibilitie" class="form-control" />
                <span asp-validation-for="Responsibilitie" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="OtherBenefit" class="control-label"></label>
                <input asp-for="OtherBenefit" class="form-control" />
                <span asp-validation-for="OtherBenefit" class="text-danger"></span>
            </div>
          @*  <div class="form-group">
                <label asp-for="Workplace" class="control-label"></label>
                <input asp-for="Workplace" class="form-control" />
                <span asp-validation-for="Workplace" class="text-danger"></span>
            </div> *@

            <div class="form-group">
                <label class="font-weight-bold">Workplace</label>
                <div>
                    <input type="radio" id="remote" name="Workplace" value="Remote" @(Model.Workplace == "Remote" ? "checked" : "")>
                    <label for="remote">Remote</label>

                    <input type="radio" id="onsite" name="Workplace" value="On-site" @(Model.Workplace == "On-site" ? "checked" : "")>
                    <label for="onsite">On-site</label>

                    <input type="radio" id="hybrid" name="Workplace" value="Hybrid" @(Model.Workplace == "Hybrid" ? "checked" : "")>
                    <label for="hybrid">Hybrid</label>
                </div>
            </div>



        @*  <div class="form-group">
                <label asp-for="EmploymentStatus" class="control-label"></label>
                <input asp-for="EmploymentStatus" class="form-control" />
                <span asp-validation-for="EmploymentStatus" class="text-danger"></span>
            </div> *@

            <div class="form-group">
                <label class="font-weight-bold">Employment Status</label>
                <div class="btn-group-toggle" data-toggle="buttons">
                    <label class="btn btn-outline-primary @(Model.EmploymentStatus == "Full Time" ? "active" : "")">
                        <input type="radio" name="EmploymentStatus" value="Full Time" @(Model.EmploymentStatus == "Full Time" ? "checked" : "")> Full Time
                    </label>
                    <label class="btn btn-outline-primary @(Model.EmploymentStatus == "Part Time" ? "active" : "")">
                        <input type="radio" name="EmploymentStatus" value="Part Time" @(Model.EmploymentStatus == "Part Time" ? "checked" : "")> Part Time
                    </label>
                    <label class="btn btn-outline-primary @(Model.EmploymentStatus == "Internship" ? "active" : "")">
                        <input type="radio" name="EmploymentStatus" value="Internship" @(Model.EmploymentStatus == "Internship" ? "checked" : "")> Internship
                    </label>
                </div>
            </div>



            <div class="form-group">
                <label asp-for="JobLocation" class="control-label"></label>
                <input asp-for="JobLocation" class="form-control" />
                <span asp-validation-for="JobLocation" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Salary" class="control-label"></label>
                <input asp-for="Salary" class="form-control" />
                <span asp-validation-for="Salary" class="text-danger"></span>
            </div>
           @*  <div class="form-group">
                <label asp-for="JobPostedDate" class="control-label"></label>
                <input asp-for="JobPostedDate" class="form-control" />
                <span asp-validation-for="JobPostedDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ApplicationDeadline" class="control-label"></label>
                <input asp-for="ApplicationDeadline" class="form-control" />
                <span asp-validation-for="ApplicationDeadline" class="text-danger"></span> 
            </div> *@

            <div class="form-group">
                <label>Job Posted Date</label>
                <input asp-for="JobPostedDate" type="date" class="form-control" />
            </div>

            <div class="form-group">
                <label>Application Deadline</label>
                <input asp-for="ApplicationDeadline" type="date" class="form-control" />
            </div>


            <div class="form-group">
                <label asp-for="CategoryId" class="control-label">Category Name</label>
                <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryId"></select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EmployerId" class="control-label">Employer Name</label>
                <select asp-for="EmployerId" class="form-control" asp-items="ViewBag.EmployerId"></select>
                <span asp-validation-for="EmployerId" class="text-danger"></span>
            </div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <input type="submit" value="Save Changes" class="btn btn-primary" /> |
                <a asp-controller="EmployerDashboard" asp-action="MyJobPost" class="btn btn-warning">Cancel</a>
            </div>
        </form>
    </div>
</div>

