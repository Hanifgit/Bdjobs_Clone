@model RegistrationPage.Models.AddUpazilaViewModel

<h1>Add Upazila</h1>

<form method="post">
    <div class="mt-3">
        <label class="form-label">Upazila</label>
        <input type="text" class="form-control" asp-for="Name" />
    </div>

    <div class="mt-3">
        <label class="form-label">DistrictId</label>
        <input type="text" class="form-control" asp-for="DistrictId" />
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
    </div>

</form>