@model RegistrationPage.Models.AddCountryViewModel

<h1>Add Country</h1>

<form method="post">
    <div class="mt-3">
        <label class="form-label">Country</label>
        <input type="text" class="form-control" asp-for="Name" />
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
    </div>

</form>
