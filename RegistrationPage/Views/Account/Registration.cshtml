@model RegistrationPage.Models.RegistrationViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f9f9f9;
            font-family: Arial, sans-serif;
        }

        .registration-form {
            max-width: 800px;
            margin: 20px auto;
            background: #fff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

            .registration-form h2 {
                text-align: center;
                margin-bottom: 20px;
                color: #007bff;
            }

        .form-control {
            border-radius: 5px;
        }

        .form-group label {
            font-weight: bold;
            margin-top: 10px;
        }

        .form-section {
            margin-bottom: 20px;
        }

        .btn-primary {
            width: 100%;
            padding: 10px;
            font-size: 16px;
        }
    </style>
</head>
<body>
    <div class="registration-form">
        <h2>Create Account</h2>
        <form asp-action="Registration" method="post">
            <div class="form-section">
                <h3>Personal Information</h3>
                <div class="form-group">
                    <label>Name</label>
                    <input asp-for="Name" class="form-control" placeholder="Enter your name" />
                </div>
                <div class="form-group">
                    <label>Email</label>
                    <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                </div>
                <div class="form-group">
                    <label>Mobile Number</label>
                    <input asp-for="MobileNumber" class="form-control" placeholder="Enter your mobile number" />
                </div>
                <div class="form-group">
                    <label>Gender</label><br />
                    <div class="form-check form-check-inline">
                        <input type="radio" id="genderMale" name="Gender" value="Male" asp-for="Gender" class="form-check-input" checked />
                        <label for="genderMale" class="form-check-label">Male</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input type="radio" id="genderFemale" name="Gender" value="Female" asp-for="Gender" class="form-check-input" />
                        <label for="genderFemale" class="form-check-label">Female</label>
                    </div>
                </div>
                <div class="form-group">
                    <label>Age</label>
                    <input asp-for="Age" class="form-control" placeholder="Enter your age" />
                </div>
                <div class="form-group">
                    <label>Skill</label>
                    <input asp-for="Skill" class="form-control" placeholder="Enter your skill" />
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" />
                </div>
            </div>

             <div class="form-section">
                <h3>Address Information</h3>
                @* <div class="form-group">
                    <label>Country</label>
                    <select id="CountryId" name="SelectedCountry" asp-items="Model.Countries" class="form-control">
                        <option value="">-- Select Country --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>District</label>
                    <select id="DistrictId" name="SelectedDistrict" asp-items="Model.Districts" class="form-control">
                        <option value="">-- Select District --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Upazila</label>
                    <select id="UpazilaId" name="SelectedUpazila" asp-items="Model.Upazilas" class="form-control">
                        <option value="">-- Select Upazila --</option>
                    </select>
                </div>  *@

                <div class="form-group">
                    <label for="SelectedCountry">Country</label>
                    <select id="SelectedCountry" name="SelectedCountry" class="form-control">
                        <option value="">-- Select Country --</option>
                        @foreach (var country in Model.Countries)

                        {
                            <option value="@country.Value">@country.Text</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="SelectedDistrict">District</label>
                    <select id="SelectedDistrict" name="SelectedDistrict" class="form-control">
                        <option value="">-- Select District --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="SelectedUpazila">Upazila</label>
                    <select id="SelectedUpazila" name="SelectedUpazila" class="form-control">
                        <option value="">-- Select Upazila --</option>
                    </select>
                </div>


                <div class="form-group">
                    <label>Post Office</label>
                    <input asp-for="PostOffice" class="form-control" placeholder="Enter post office" />
                </div>
                <div class="form-group">
                    <label>House No./Road /Village</label>
                    <input asp-for="Village" class="form-control" placeholder="Enter your address" />
                </div>
            </div>

            <div class="form-section">
                <h3>Educational Qualifications</h3>
                <div id="educational-qualifications-section">
                    @for (int i = 0; i < Model.EducationalQualifications.Count; i++)

                    {
                        <div class="form-group">
                            <label>Educational Stage</label>
                            <input asp-for="EducationalQualifications[@i].EducationalStage" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label>Name of Institution</label>
                            <input asp-for="EducationalQualifications[@i].NameOfEducationalInstitution" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label>Major Subject</label>
                            <input asp-for="EducationalQualifications[@i].MajorSubject" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label>Board</label>
                            <input asp-for="EducationalQualifications[@i].Board" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label>Year of Passing</label>
                            <select asp-for="EducationalQualifications[@i].YearOfPassing" asp-items="Model.EducationalQualifications[@i].YearDropdown" class="form-control">
                                <option value="">-- Select Year --</option>
                            </select>
                        </div>
                    }
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Register</button>
          
        </form>
    </div>
</body>
</html>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $("#SelectedCountry").change(function () {
            var countryId = $(this).val();
            $("#SelectedDistrict").empty().append('<option value="">-- Select District --</option>');
            $("#SelectedUpazila").empty().append('<option value="">-- Select Upazila --</option>');

            if (countryId) {
                $.getJSON("/Account/GetDistrictsByCountry", { countryId: countryId }, function (data) {
                    $.each(data, function (index, item) {
                        $("#SelectedDistrict").append($('<option>', {
                            value: item.id,
                            text: item.name
                        }));
                    });
                });
            }
        });

        $("#SelectedDistrict").change(function () {
            var districtId = $(this).val();
            $("#SelectedUpazila").empty().append('<option value="">-- Select Upazila --</option>');

            if (districtId) {
                $.getJSON("/Account/GetUpazilasByDistrict", { districtId: districtId }, function (data) {
                    $.each(data, function (index, item) {
                        $("#SelectedUpazila").append($('<option>', {
                            value: item.id,
                            text: item.name
                        }));
                    });
                });
            }
        });
    });
</script>

