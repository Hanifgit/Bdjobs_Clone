@model RegistrationPage.Models.CVViewModel

@{
    ViewData["Title"] = "Resume";
}

<style>
    .card {
        border-radius: 10px;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
    }
    .rounded-circle {
        border: 3px solid #007bff;
    }
    .list-group-item {
        border: none;
        background: transparent;
    }
    .thead-dark {
        background-color: #343a40;
        color: white;
    }
    .text-primary, .text-success {
        font-weight: bold;
    }
</style>

<div class="container mt-4">
    <div class="row">
        <!-- Left Section (Profile Info) -->
        <div class="col-md-4">
            <div class="card p-3 shadow-sm">
                <div class="text-center">
                    <img src="~/images/profile-placeholder.png" class="rounded-circle img-thumbnail" width="120" />
                    <h4 class="mt-3">@Model.Name</h4>
                </div>
                <hr />
                <div>
                    <p><i class="fas fa-envelope text-primary"></i> @Model.Email</p>
                    <p><i class="fas fa-phone text-primary"></i> @Model.MobileNumber</p>
                    <p><i class="fas fa-user text-primary"></i> <strong>Gender :</strong> @Model.Gender</p>
                    <p><i class="fas fa-birthday-cake text-primary"></i> <strong>Age :</strong> @Model.Age</p>
                </div>
                <hr />
               @*  <h5 ><i class="fas fa-map-marker-alt text-danger"></i> Address</h5> *@
                <h5 class="text-info"><i class="fas fa-graduation-cap"></i> Address</h5>

                @foreach (var address in Model.Addresses)
                {
                    <p><strong>Country :</strong> @address.CountryName</p>
                    <p><strong>District :</strong> @address.DistrictName</p>
                    <p><strong>Upazila :</strong> @address.UpazilaName</p>
                    <p><strong>Post Office :</strong> @address.PostOffice</p>
                    <p><strong>Village :</strong> @address.Village</p>
                }
            </div>
        </div>

        <!-- Right Section (Skills & Education) -->
        <div class="col-md-8">
            <div class="card p-3 shadow-sm">
                <h5 class="text-success"><i class="fas fa-tools"></i> Skills</h5>
                <ul class="list-group">
                    <p><strong></strong> @Model.Skill</p>

                </ul>

                <hr />

                <h5 class="text-primary"><i class="fas fa-graduation-cap"></i> Educational Qualifications</h5>
                <table class="table table-bordered">
                    <thead class="thead-dark">
                        <tr>
                            <th>Stage</th>
                            <th>Institution</th>
                            <th>Major</th>
                            <th>Board</th>
                            <th>Year</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var eq in Model.EducationalQualifications)
                        {
                            <tr>
                                <td>@eq.EducationalStage</td>
                                <td>@eq.NameOfEducationalInstitution</td>
                                <td>@eq.MajorSubject</td>
                                <td>@eq.Board</td>
                                <td>@eq.YearOfPassing</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div>


    <div>
        @if (ViewBag.IsEmployer == true)
        {
            <!-- If Employer is logged in, show this button -->
            <a href="@Url.Action("ViewApplicant", "EmployerDashboard", new { jobId = ViewBag.JobId })" class="btn btn-success">
                Back to Applicants List
            </a>
        }
        else
        {
            <!-- If CreateAccount user is logged in, show this button -->
            <a href="@Url.Action("MyJobDashboard", "CreateAccountDashboard")" class="btn btn-success">
                Back to Dashboard
            </a>
        }
    </div>



</div>


